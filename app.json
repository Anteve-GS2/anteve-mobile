{
  "expo": {
    "name": "anteve-app",
    "slug": "anteve-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "anteveapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "br.com.gs2.anteveapp",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static"
    },
    "extra": {
      "commitHash": "1921363",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fcc428f9-5321-4a50-a52a-6e6bbb94f96f"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
